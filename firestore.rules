rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection
    match /users/{email} {
      allow read: if request.auth != null && request.auth.uid != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid != null && 
        (request.resource.data.email == email);
      allow delete: if request.auth != null && request.auth.uid != null &&
        (resource.data.email == email);
    }
    
    // Tasks collection
    match /tasks/{taskId} {
      allow read: if request.auth != null && resource.data.userEmail == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userEmail == request.auth.uid;
      allow update: if request.auth != null && resource.data.userEmail == request.auth.uid;
      allow delete: if request.auth != null && resource.data.userEmail == request.auth.uid;
    }
  }
}